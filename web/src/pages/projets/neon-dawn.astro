---
import "~/styles/neon-dawn.css"
import "~/styles/neon-dawn-api.css"

import Html from "~/layouts/default-html.astro"

import Background from "~/components/neon-dawn/background.astro"
import Satellite  from "~/components/neon-dawn/satellite/mod"
---
<Html titre="Livio Ardoin - Neon-dawn">
    <header>
        <Background/>
        <img id="earth" src="/neon-dawn/img/earth.webp" alt="Terre">
        <div>
            <h2>
                NEON-DAWN
            </h2>
            <p>
                Prêt à passer en orbite?
            </p>
        </div>
        <a href="/">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" 
                viewBox="0 0 24 24" fill="none" stroke="#fff" 
                stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m15 18-6-6 6-6"/>
            </svg>
            Revenir
        </a>
    </header>
    <Satellite client:only="solid-js"/>
    <!-- <Api/> -->
    <!-- <iframe src="http://localhost/helper/?embedded" style="overflow: hidden;"/> -->
    <iframe src="https://neon-dawn.loshido.me/helper/?embedded" style="overflow: hidden;"/>
</Html>