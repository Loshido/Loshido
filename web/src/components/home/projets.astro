---
const projets = [
    {
        title: "Color-Burn",
        href: 'https://color-burn.loshido.me',
        date: 'Feb. 2026',
        external: true,
        description: `Un jeu dans lequel vous devez rassembler chaque couleur dans une bouteille.`
    },
    {
        title: "Sens",
        href: '',
        date: 'Jan. 2026',
        progress: 0,
        description: `Une plateforme de gestion d'engagements.<br/>`
        + `Mesurer l'engagement responsable des étudiants sous forme d'objectifs à accomplir.`
    },
    {
        title: "Link IE",
        href: '',
        date: 'Dec. 2025',
        progress: 0,
        description: `Une plateforme pour créer des liens de redirections,<br/>`
        + `notamment pour l'association IsenEngineering.`
    },
    {
        title: "Kernel-Panic",
        href: '',
        date: 'Nov. 2025',
        progress: 0,
        description: `Un hackaton limité à l'utilisation d'un conteneur.<br/>`
        + `Les participants y sont en concurrence avec un classement en temps réel.`
    },
    {
        title: "La Bourse Folle",
        href: '',
        date: 'Sep. 2025',
        progress: 0,
        description: `Une plateforme type bourse dans laquelle le prix des boissons fluctuent en fonction `
        + `des consommations (à l'occasion de soirées de l'association IsenEngineering).`
    },
    {
        href: 'https://neon-dawn.loshido.me/',
        date: 'Aug. 2025',
        title: "Neon-Dawn",
        external: true,
        description: `Un hackaton dans lequel les participants doivent mettre en orbite un satellite `
        + `avec du code.`
    },
    {
        href: 'https://explorer.loshido.me',
        date: 'Feb. 2025',
        title: "Explorer",
        external: true,
        description: `Une légère interface pour accéder à mes fichiers depuis internet `
        + `sans passer par un réseau privée (type Wireguard)`
    },
    {
        href: '',
        date: 'May. 2025',
        title: "All Game Long - Bet",
        progress: 0,
        description: `Une plateforme qui permet de parier des sommes fictives<br/>`
        + `à l'occasion d'un évènement sur une soirée compétitive. `
        + `Qui aura le plus d'argents à la fin de la soirée?`
    },
    {
        href: 'https://tide.isenengineering.fr',
        date: 'Sep. 2024',
        title: "Tidee",
        external: true,
        description: `Une plateforme de gestion des présences et des membres de l'association IsenEngineering.<br/>`
        + `Elle permet de mesurer l'engagement responsable en heures.`
    },
    {
        href: 'https://island-generation.vercel.app',
        external: true,
        date: 'May. 2023',
        title: "Island Generation",
        description: `Génération procédurale d'îles paradisiaques.`
    },
] as {
    href: string,
    date: string,
    title: string,
    external?: boolean,
    progress?: 0 | 1 | 2 | 3 | 4
    description: string
}[]
---

<h2>
    Mes projets
</h2>
<img alt="Séparateur"
    loading="eager" src="/home/img/line.svg" height="16"/>
<section class="articles">
    {
        projets.map(projet => <a
            href={projet.href} data-date={projet.date}
            target={projet.external ? '_blank' : '_self'}>
            <h3>
                { projet.title } 
                <span class="green" title="Progression de l'écriture des pages">
                    { projet.progress === 0 ? '○' : '' }
                    { projet.progress === 1 ? '◔' : '' }
                    { projet.progress === 2 ? '◑' : '' }
                    { projet.progress === 3 ? '◕' : '' }
                    { projet.progress === 4 ? '●' : '' }
                    { projet.external === true ? '◆' : '' }
                </span>
            </h3>
            <p set:html={projet.description}/>
        </a>)
    }
</section>