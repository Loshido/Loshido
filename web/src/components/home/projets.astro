<h2>
    Mes projets
</h2>
<img alt="Séparateur"
    loading="lazy" src="/home/img/line.svg" height="16"/>
<section class="articles">
    {
        projets.map(projet => <a
            href={projet.href} data-date={projet.date}>
            <h3>
                { projet.titre } 
                <span class="green" title="Progression de l'écriture des pages">
                    { projet.progress === 0 ? '○' : '' }
                    { projet.progress === 1 ? '◔' : '' }
                    { projet.progress === 2 ? '◑' : '' }
                    { projet.progress === 3 ? '◕' : '' }
                    { projet.progress === 4 ? '●' : '' }
                </span>
            </h3>
            <p set:html={projet.description}/>
        </a>)
    }
</section>