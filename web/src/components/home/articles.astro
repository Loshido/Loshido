---
const articles = [
    {
        href: '/projets/neon-dawn',
        date: 'Feb. 2026',
        titre: "Don't just code it - Watch it fly around Earth",
        progress: 1,
        description: `Un hackaton très visuel où les participants doivent<br/>`
        + `mettre en orbite un satellite.`
    }
]

---

<h2>
    Articles / Recherches
</h2>
<img alt="Séparateur"
    loading="lazy" src="/home/img/line.svg" height="16"/>
<section class="articles">
    {
        articles.map(article => <a href={article.href} data-date={article.date}>
            <h3>
                { article.titre }
                <span title="Progression écriture des pages" class="green">
                    { article.progress === 0 ? '○' : '' }
                    { article.progress === 1 ? '◔' : '' }
                    { article.progress === 2 ? '◑' : '' }
                    { article.progress === 3 ? '◕' : '' }
                    { article.progress === 4 ? '●' : '' }
                </span>
            </h3>
            <p set:html={article.description}/>
        </a>)
    }
</section>