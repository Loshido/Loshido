---
import Launch from "./api/orbit-launch"
import Update from "./api/orbit-update"
import Signal from "./api/orbit-signal"
import Ws from "./api/ws"
import Listen from "./api/listen"

const categories = [
    {
        title: 'REST',
        endpoints: [
            {
                id: 'orbit-launch',
                method: 'POST',
                route: '/orbit/launch',
            },
            {
                id: 'orbit-update',
                method: 'POST',
                route: '/orbit/update',
            },
            {
                id: 'orbit-signal',
                method: 'POST',
                route: '/orbit/signal',
            },
        ]
    },
    {
        title: 'Websocket',
        endpoints: [
            {
                id: 'ws',
                method: 'GET',
                route: '/ws',
            }
        ]
    },
    {
        title: 'Observation',
        endpoints: [
            {
                id: 'listen',
                method: 'GET',
                route: '/listen',
            }
        ]
    },
]

---

<section class="api">
    <h2>
        API
    </h2>
    <fieldset>
        {
            categories.map(category => <>
                <h3>{ category.title }</h3>
                {
                    category.endpoints.map(endpoint => <div class="endpoint">
                        <input type="radio" id={ 'endpoint-' + endpoint.id } name="endpoint">
                        <label class="head" for={ 'endpoint-' + endpoint.id }>
                            <span 
                                class={endpoint.method.toLocaleLowerCase() + " method"}>
                                { endpoint.method }
                            </span>
                            <code>{ endpoint.route }</code>
                        </label>
                    </div>)
                }
            </>)
        }
    </fieldset>
    <div data-endpoint="orbit-launch">
        <Launch client:visible={{ rootMargin: "200px" }} client:only="solid-js"/>
    </div>
    <div data-endpoint="orbit-update">
        <Update client:visible={{ rootMargin: "200px" }} client:only="solid-js"/>
    </div>
    <div data-endpoint="orbit-signal">
        <Signal client:visible={{ rootMargin: "200px" }} client:only="solid-js"/>
    </div>
    <div data-endpoint="ws">
        <Ws client:visible={{ rootMargin: "200px" }} client:only="solid-js"/>
    </div>
    <div data-endpoint="listen">
        <Listen client:visible={{ rootMargin: "200px" }} client:only="solid-js"/>
    </div>
</section>