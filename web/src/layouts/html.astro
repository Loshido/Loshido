---
import "~/styles/global.css"
interface Props {
    titre: string,
    description?: string
}
const { titre, description } = Astro.props
---

<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>{ titre }</title>
        { 
            description 
            ? <meta name="description" content={description}> 
            : null
        }
	</head>
	<body>
		<slot/>
	</body>
</html>
